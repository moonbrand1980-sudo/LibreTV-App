name: Build LibreTV Android APK (With Background Cast)

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

jobs:
  build-android-apk:
    runs-on: ubuntu-latest
    steps:
      - name: 1. 检出当前仓库代码
        uses: actions/checkout@v4

      - name: 2. 安装 Node.js 环境
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: 3. 安装 Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 4. 配置 Android SDK 与 NDK (r26d)
        uses: android-actions/setup-android@v3

      - name: 5. 安装 Android NDK 与构建工具
        run: |
          sdkmanager --install "ndk;26.3.11579264" "platforms;android-34" "build-tools;34.0.0"
          echo "ANDROID_NDK_HOME=$ANDROID_HOME/ndk/26.3.11579264" >> $GITHUB_ENV
          echo "NDK_HOME=$ANDROID_HOME/ndk/26.3.11579264" >> $GITHUB_ENV

      - name: 6. 安装 Rust 与 Android 交叉编译目标
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-linux-android,armv7-linux-androideabi

      - name: 7. 安装前端依赖与初始化 Android 工程（若尚未初始化）
        run: |
          npm install
          npm install -D @tauri-apps/cli@^2.0.0
          if [ ! -d "src-tauri/gen/android" ]; then
            npx tauri android init
          fi

      - name: 8. 自动注入「📺 投屏 + 手机后台暂停释放」补丁
        run: |
          python3 apply_cast_patch.py

      - name: 9. 编译生成 Android APK 并自动签名
        run: |
          npx tauri android build --apk --target aarch64
          # 查找编译出的未签名或已签名 APK，使用 debug keystore 保底签名以便手机直接安装
          APK_PATH=$(find src-tauri/gen/android/app/build/outputs/apk -name "*.apk" | head -n 1)
          echo "Found APK: $APK_PATH"
          if [[ "$APK_PATH" == *"unsigned"* ]]; then
            keytool -genkey -v -keystore debug.keystore -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Android Debug,O=Android,C=US"
            $ANDROID_HOME/build-tools/34.0.0/apksigner sign --ks debug.keystore --ks-pass pass:android --key-pass pass:android --out LibreTV-Cast-Signed.apk "$APK_PATH"
          else
            cp "$APK_PATH" LibreTV-Cast-Signed.apk
          fi

      - name: 10. 上传可直接安装的 APK 成品包
        uses: actions/upload-artifact@v4
        with:
          name: LibreTV-Android-Cast-APK
          path: LibreTV-Cast-Signed.apk
